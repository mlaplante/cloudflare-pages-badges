{
  "name": "cloudflare-pages-badges",
  "version": "2.0.0",
  "description": "Badges for Cloudflare Pages projects",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write '*.{json,js,md}' 'src/**/*.ts'",
    "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js,md}' 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "author": "Aiden Wallis <github.com/aidenwallis>",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250404.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1",
    "wrangler": "^4.10.0"
  }
}
